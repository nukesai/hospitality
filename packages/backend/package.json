{
  "name": "@nukesai-pos/backend",
  "version": "0.1.0",
  "private": false,
  "description": "Nukes AI POS server-side business logic and data-access ports. SERVER ONLY.",
  "keywords": [
    "point-of-sale",
    "pos",
    "restaurant",
    "nukesai"
  ],
  "bugs": {
    "email": "info@nukesai.com"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Nukes AI & Software Solution",
    "email": "info@nukesai.com"
  },
  "sideEffects": [
    "./dist/adapters/cache/memory.js",
    "./dist/adapters/cache/redis.js",
    "./dist/adapters/cache/upstash.js",
    "./dist/adapters/demo/index.js",
    "./dist/adapters/drizzle/index.js",
    "./dist/adapters/logging/pino.js",
    "./dist/auth/index.js",
    "./dist/bootstrap/index.js",
    "./dist/cache/index.js",
    "./dist/index.js",
    "./dist/internal/browser-guard.js",
    "./dist/next/index.js",
    "./dist/trpc/index.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/env.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/bootstrap/index.js"
    },
    "./trpc": {
      "types": "./dist/trpc/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/trpc/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/next/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/cache/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/auth/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/ports/index.js"
    },
    "./adapters/demo": {
      "types": "./dist/adapters/demo/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/adapters/demo/index.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/adapters/drizzle/index.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/adapters/drizzle/index.js"
    },
    "./adapters/cache-redis": {
      "types": "./dist/adapters/cache/redis.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/adapters/cache/redis.js"
    },
    "./adapters/cache-upstash": {
      "types": "./dist/adapters/cache/upstash.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/adapters/cache/upstash.js"
    },
    "./adapters/cache-memory": {
      "types": "./dist/adapters/cache/memory.d.ts",
      "default": "./dist/adapters/cache/memory.js"
    },
    "./adapters/logging": {
      "types": "./dist/adapters/logging/pino.d.ts",
      "browser": "./dist/internal/browser-guard.js",
      "default": "./dist/adapters/logging/pino.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "db:check": "drizzle-kit check",
    "db:custom": "drizzle-kit generate --custom",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env scripts/db-seed.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nukesai-pos/common": "workspace:^",
    "@scalar/nextjs-api-reference": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "nodemailer": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "server-only": "catalog:",
    "superjson": "catalog:",
    "trpc-to-openapi": "catalog:",
    "zod": "catalog:",
    "zod-openapi": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@nukesai-pos/eslint-config": "workspace:*",
    "@nukesai-pos/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@upstash/redis": "catalog:",
    "@vercel/functions": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "ioredis": "catalog:",
    "next": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.38.2",
    "@vercel/functions": "^3.9.5",
    "ioredis": "^6.0.0",
    "next": "^16.3.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "@vercel/functions": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
