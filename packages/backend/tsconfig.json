{
  "extends": "@nukesai-pos/typescript-config/library.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "tsdown.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "drizzle.config.ts",
    "scripts/**/*.ts",
    "test-integration/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
