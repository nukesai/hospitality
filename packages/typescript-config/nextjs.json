{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@nukesai-pos/typescript-config/nextjs",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "erasableSyntaxOnly": false,
    "types": ["node", "react"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
