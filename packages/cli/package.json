{
  "name": "@nukesai-pos/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Scaffold Nukes POS into an existing Next.js 16 application.",
  "keywords": [
    "point-of-sale",
    "pos",
    "restaurant",
    "nukesai",
    "cli"
  ],
  "bugs": {
    "email": "info@nukesai.com"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Nukes AI & Software Solution",
    "email": "info@nukesai.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
