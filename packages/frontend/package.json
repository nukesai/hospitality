{
  "name": "@nukesai-pos/frontend",
  "version": "0.0.0",
  "private": false,
  "description": "Nukes AI POS admin panel UI (RSC + client components).",
  "keywords": [
    "point-of-sale",
    "pos",
    "restaurant",
    "nukesai"
  ],
  "bugs": {
    "email": "info@nukesai.com"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "Nukes AI & Software Solution",
    "email": "info@nukesai.com"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/server/index.js"
  ],
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "default": "./dist/locales/*.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./next-config": {
      "types": "./dist/next-config/index.d.ts",
      "default": "./dist/next-config/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "default": "./dist/proxy/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "styles.css",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nukesai-pos/common": "workspace:^",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@nukesai-pos/eslint-config": "workspace:*",
    "@nukesai-pos/typescript-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "better-auth": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "superjson": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.3",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.1",
    "next": "^16.3.0",
    "next-intl": "^4.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "superjson": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false,
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
