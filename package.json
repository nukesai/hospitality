{
  "name": "@nukesai-pos/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Nukes AI point-of-sale platform monorepo.",
  "license": "GPL-3.0-or-later",
  "author": "Nukes AI & Software Solution <info@nukesai.com>",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "git fetch --no-tags origin +refs/heads/main:refs/heads/main && changeset status",
    "changesets:verify": "node scripts/assert-changeset-covers-group.mjs",
    "channels:verify": "node scripts/assert-release-channel.mjs",
    "check-types": "turbo run check-types",
    "coverage:canary": "node scripts/assert-coverage-gate-fails.mjs",
    "db:generate": "pnpm --filter @nukesai-pos/backend db:generate",
    "db:migrate": "pnpm --filter @nukesai-pos/backend db:migrate",
    "db:seed": "pnpm --filter @nukesai-pos/backend db:seed",
    "dev": "turbo run dev",
    "dev:full": "pnpm stack:up && pnpm db:migrate && pnpm db:seed && turbo run dev",
    "e2e": "turbo run build --output-logs=errors-only && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "turbo run lint",
    "lint:bans": "node scripts/assert-lint-bans.mjs",
    "prepare": "husky",
    "release": "node scripts/release.mjs --channel latest",
    "release:beta": "node scripts/release.mjs --channel beta",
    "release:canary": "node scripts/release.mjs --channel canary",
    "size": "size-limit",
    "stack:down": "docker compose -f docker/compose.yaml down",
    "stack:nuke": "docker compose -f docker/compose.yaml down -v",
    "stack:up": "docker compose -f docker/compose.yaml --env-file .env up -d --wait",
    "syncpack:lint": "syncpack lint",
    "test": "turbo run build --output-logs=errors-only && vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "verify:published": "node scripts/verify-published.mjs",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "catalog:",
    "size-limit": "catalog:",
    "syncpack": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.10.0"
  }
}
